{
  "daemon": true,
  "run": [
    {
      "method": "log",
      "params": {
        "html": "<p>&#x1F504; Iniciando Ollama...</p>"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "{{platform === 'win32' ? 'start /B ollama serve > NUL 2>&1' : 'ollama serve > /dev/null 2>&1 &'}}",
        "path": "{{cwd}}"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "{{platform === 'win32' ? 'timeout /t 3 /nobreak > NUL' : 'sleep 3'}}",
        "path": "{{cwd}}"
      }
    },
    {
      "method": "log",
      "params": {
        "html": "<p>&#x1F680; Iniciando servidor CSS Brand Assistant en puerto {{port}}...</p>"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "python server/app.py",
        "path": "{{cwd}}",
        "venv": "venv",
        "env": {
          "PORT": "{{port}}",
          "DATA_DIR": "{{cwd}}/data",
          "OLLAMA_URL": "http://localhost:11434"
        }
      }
    }
  ]
}

{
  "daemon": true,
  "run": [
    {
      "method": "log",
      "params": {
        "html": "<p>🔄 Verificando dependencias...</p>"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "venv/bin/python -c \"import fastapi\" 2>/dev/null || (echo 'Instalando dependencias...' && venv/bin/pip install -r requirements.txt --quiet)",
        "path": "{{cwd}}"
      }
    },
    {
      "method": "log",
      "params": {
        "html": "<p>🔄 Iniciando Ollama...</p>"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "ollama serve > /dev/null 2>&1 & sleep 2 && curl -s http://localhost:11434/api/tags > /dev/null || true"
      }
    },
    {
      "method": "log",
      "params": {
        "html": "<p>🚀 Iniciando servidor en puerto {{port}}...</p>"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "venv/bin/python server/app.py",
        "path": "{{cwd}}",
        "env": {
          "PORT": "{{port}}",
          "DATA_DIR": "{{cwd}}/data",
          "OLLAMA_URL": "http://localhost:11434"
        }
      }
    }
  ]
}

{
  "daemon": true,
  "run": [
    {
      "method": "log",
      "params": {
        "html": "<p>&#x25B6;&#xFE0F; Iniciando Ollama...</p>"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "{{platform === 'win32' ? 'start \"\" /B ollama serve 2>NUL' : 'ollama serve > /dev/null 2>&1 &'}}",
        "path": "{{cwd}}"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "{{platform === 'win32' ? 'timeout /t 3 /nobreak > NUL' : 'sleep 3'}}",
        "path": "{{cwd}}"
      }
    },
    {
      "method": "log",
      "params": {
        "html": "<p>&#x1F680; Iniciando servidor CSS Brand Assistant en puerto {{port}}...</p>"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "{{platform === 'win32' ? 'venv\\\\Scripts\\\\python.exe server/app.py' : 'venv/bin/python server/app.py'}}",
        "path": "{{cwd}}",
        "env": {
          "PORT": "{{port}}",
          "DATA_DIR": "{{cwd}}/data",
          "OLLAMA_URL": "http://localhost:11434"
        }
      }
    }
  ]
}

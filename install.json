{
  "run": [
    {
      "method": "log",
      "params": {
        "html": "<h3>🚀 Instalando CSS Brand Assistant...</h3>"
      }
    },
    {
      "method": "log",
      "params": {
        "html": "<p>Verificando Ollama...</p>"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "ollama --version"
      }
    },
    {
      "method": "log",
      "params": {
        "html": "<p>Iniciando servicio Ollama...</p>"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "ollama serve > /dev/null 2>&1 &"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "sleep 3 && curl -s http://localhost:11434/api/tags > /dev/null || true"
      }
    },
    {
      "method": "log",
      "params": {
        "html": "<p>⬇️ Descargando modelo de IA (puede tardar varios minutos)...</p>"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "{{ram < 6 ? 'ollama pull llama3.2:1b' : ram < 12 ? 'ollama pull llama3.2:3b' : 'ollama pull llama3.1:8b'}}"
      }
    },
    {
      "method": "log",
      "params": {
        "html": "<p>🐍 Creando entorno Python e instalando dependencias...</p>"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "python3 -m venv venv && venv/bin/pip install --upgrade pip --quiet && venv/bin/pip install -r requirements.txt --quiet && echo DEPS_OK",
        "path": "{{cwd}}"
      }
    },
    {
      "method": "log",
      "params": {
        "html": "<p>💾 Inicializando directorios de datos...</p>"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "mkdir -p data/agents data/prompts/system data/sessions data/exports data/brands data/campaigns data/audit",
        "path": "{{cwd}}"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "cp defaults/agents.json data/agents/agents.json 2>/dev/null || true",
        "path": "{{cwd}}"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "cp defaults/prompts/*.md data/prompts/system/ 2>/dev/null || true",
        "path": "{{cwd}}"
      }
    },
    {
      "method": "fs.write",
      "params": {
        "path": "data/config.json",
        "text": "{{JSON.stringify({version: '0.1.0', installedAt: new Date().toISOString(), defaultModel: ram < 6 ? 'llama3.2:1b' : ram < 12 ? 'llama3.2:3b' : 'llama3.1:8b'}, null, 2)}}"
      }
    },
    {
      "method": "log",
      "params": {
        "html": "<h3 style='color: #22c55e'>✅ Instalación completada</h3><p>Haz click en <strong>Iniciar</strong> para comenzar a usar CSS Brand Assistant.</p>"
      }
    },
    {
      "method": "notify",
      "params": {
        "html": "CSS Brand Assistant instalado correctamente."
      }
    }
  ]
}
